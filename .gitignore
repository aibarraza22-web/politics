# secrets
.env

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# data: everything under data/ is regenerable from `make` targets + APIs.
# Hand-curated inputs live in src/ (e.g. src/estimators/c_anchors/), not here.
data/**
!data/*/
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/final/.gitkeep
*.duckdb
*.duckdb.wal

# quarto / paper build outputs
/.quarto/
paper/.quarto/
paper/_output/
paper/figures/
paper/*_files/

# explorer/data.js is generated (via `make demo` / `make real`) but IS
# committed: it's the deployed explorer's only data source, and static hosts
# (Vercel/GitHub Pages) have no way to regenerate it. Refresh + commit after
# a real rebuild. (Do not gitignore it or the deployed page renders blank.)

# misc
.DS_Store
.ipynb_checkpoints/
